<Window x:Class="HotVirtualKeyboard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Keyboard Settings"
        Height="580" Width="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Windows 11 Fluent Toggle Switch Style for CheckBox -->
        <Style x:Key="FluentToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" Background="#484854" BorderBrush="#5A5A68" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#E0E0E0" HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Card Style -->
        <Style x:Key="FluentSettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#24242A"/>
            <Setter Property="BorderBrush" Value="#383842"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>

        <!-- Modern Primary Button Style -->
        <Style x:Key="FluentPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Secondary Button Style -->
        <Style x:Key="FluentSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#2F2F38"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#454552"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3D3D48"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#222228"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Nav Pill Button Style -->
        <Style x:Key="NavPillButtonStyle" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C2C34"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Modern Fluent Window Shell (Allows dragging anywhere) -->
    <Border Background="#1C1C22" BorderBrush="#363640" BorderThickness="1.5" CornerRadius="12" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- Modern Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Modern Tab Navigation Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Tab Content Body -->
                <RowDefinition Height="*"/>
                <!-- Bottom Action Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Title Bar & Drag Header -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="19" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Hot Virtual Keyboard Settings" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#33333E" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v2.0 Fluent" FontSize="10" Foreground="#A0A0B0" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Click="BtnCancel_Click" Background="Transparent" Foreground="#888894" 
                        BorderThickness="0" FontSize="14" Width="32" Height="30" Focusable="False" Cursor="Hand"/>
            </Grid>

            <!-- ROW 1: Modern Segmented Navigation Bar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="NavBtnTyping" Content="⚡ General &amp; Typing" Style="{StaticResource NavPillButtonStyle}" IsChecked="True" Checked="NavBtn_Checked"/>
                <RadioButton x:Name="NavBtnAppearance" Content="🎨 Appearance &amp; Size" Style="{StaticResource NavPillButtonStyle}" Checked="NavBtn_Checked"/>
                <RadioButton x:Name="NavBtnLockScreen" Content="🔒 Lock Screen &amp; Security" Style="{StaticResource NavPillButtonStyle}" Checked="NavBtn_Checked"/>
            </StackPanel>

            <!-- ROW 2: Content Sections -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <!-- PANEL 1: General & Typing -->
                <ScrollViewer x:Name="PanelTyping" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Card: Auto-Show on Text Focus -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Auto-Show on Text Field Focus" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Automatically pops up keyboard when touching or clicking text inputs, and auto-hides when clicking on non-input areas." 
                                               FontSize="11" Foreground="#9595A2" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkAutoShow" Style="{StaticResource FluentToggleSwitchStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Card: Audio Feedback & Test Sound -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Tactile Audio Feedback (Soft Tick)" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Play a subtle, modern low-volume tick on keystroke (quiet, non-punchy sound)." 
                                               FontSize="11" Foreground="#9595A2" TextWrapping="Wrap" Margin="0,3,0,6"/>
                                    <Button x:Name="BtnTestSound" Content="🔊 Test Keystroke Sound" Click="BtnTestSound_Click" Style="{StaticResource FluentSecondaryButtonStyle}" HorizontalAlignment="Left" Width="170"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkSound" Style="{StaticResource FluentToggleSwitchStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Card: Voice Input & Dictation -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Voice Typing &amp; Speech Dictation (🎙)" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Dictate text directly using Windows Voice Typing (Win+H) or the 🎙 microphone key on the keyboard." 
                                               FontSize="11" Foreground="#9595A2" TextWrapping="Wrap" Margin="0,3,0,6"/>
                                    <Button x:Name="BtnTestVoice" Content="🎙 Test Voice Dictation" Click="BtnTestVoice_Click" Style="{StaticResource FluentSecondaryButtonStyle}" HorizontalAlignment="Left" Width="170"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#282834" BorderBrush="#3E3E4C" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Win + H" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0B0"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card: Key Repeat Settings -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Key Repeat Rates" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Control how fast keys like Backspace, Delete, and Space repeat when held down." 
                                           FontSize="11" Foreground="#9595A2" Margin="0,3,0,10"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Initial Repeat Delay:" VerticalAlignment="Center" Foreground="#C0C0C8" FontSize="12"/>
                                    <Slider Grid.Column="1" x:Name="SliderRepeatDelay" Minimum="200" Maximum="800" Value="400" TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ElementName=SliderRepeatDelay, Path=Value, StringFormat={}{0}ms}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A0A0A8" FontSize="12"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Repeat Interval:" VerticalAlignment="Center" Foreground="#C0C0C8" FontSize="12"/>
                                    <Slider Grid.Column="1" x:Name="SliderRepeatInterval" Minimum="20" Maximum="120" Value="50" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ElementName=SliderRepeatInterval, Path=Value, StringFormat={}{0}ms}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A0A0A8" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PANEL 2: Appearance & Size -->
                <ScrollViewer x:Name="PanelAppearance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Card: Visual Themes (Windows 10/11 Fluent, Solid Filled, Apple Glassmorphism, Apple Translucent Dark) -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="🎨 Keyboard Visual Themes" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Select your preferred styling from modern Windows Fluent to frosted Apple Glassmorphism:" 
                                           FontSize="11" Foreground="#9595A2" Margin="0,3,0,10"/>

                                <RadioButton x:Name="RbThemeDarkFluent" GroupName="Theme" Foreground="#E0E0E0" Margin="0,4" IsChecked="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Windows 10/11 Fluent (Default)" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text=" — Acrylic dark glass with adaptive Windows accent tap flash" Foreground="#9090A0" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbThemeSolidFilled" GroupName="Theme" Foreground="#E0E0E0" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Solid Filled Matte Dark" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text=" — 100% opaque matte obsidian, high-contrast keys, zero blur" Foreground="#9090A0" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbThemeAppleGlassmorphism" GroupName="Theme" Foreground="#E0E0E0" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Apple Liquid Glass (iOS Frosted Crystal Glass)" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text=" — Liquid crystal gradients, specular rim reflections, floating pebble keys" Foreground="#9090A0" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbThemeAppleTranslucentDark" GroupName="Theme" Foreground="#E0E0E0" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Apple Translucent Blurred (Dark Liquid Glass)" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text=" — macOS smoky liquid obsidian glass with floating smoky tiles and azure glow" Foreground="#9090A0" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- Card: Windows Accent Color Swatch & Test Tap -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Adaptive Windows Accent Color" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Button taps, active modifiers (Shift, Caps, Ctrl), and tool highlights automatically adopt your personal Windows accent color." 
                                               FontSize="11" Foreground="#9595A2" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnTestTapAccent" Content="✨ Test Key Tap Color" Click="BtnTestTapAccent_Click" Style="{StaticResource FluentSecondaryButtonStyle}" Width="160" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TxtAccentStatus" Text="Accent Connected" FontSize="11" Foreground="#10B981" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Accent Color Swatch Display -->
                                <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="18" Width="36" Height="36" VerticalAlignment="Center">
                                    <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card: Window Size & Border Dragging -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Keyboard Window Sizing &amp; Presets" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Drag any border or corner of the keyboard window to freely resize it, or choose a quick preset below:" 
                                           FontSize="11" Foreground="#9595A2" Margin="0,3,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Compact (720x250)" Tag="compact" Click="BtnPresetFromSettings_Click" Style="{StaticResource FluentSecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="Standard (860x310)" Tag="standard" Click="BtnPresetFromSettings_Click" Style="{StaticResource FluentSecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="Large (1000x360)" Tag="large" Click="BtnPresetFromSettings_Click" Style="{StaticResource FluentSecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="Wide (1180x400)" Tag="wide" Click="BtnPresetFromSettings_Click" Style="{StaticResource FluentSecondaryButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card: Docking Mode -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Docking Mode" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Choose how the keyboard is anchored on your display." 
                                           FontSize="11" Foreground="#9595A2" Margin="0,3,0,8"/>
                                <RadioButton x:Name="RbDockBottom" Content="Dock to Screen Bottom (Full width above Taskbar)" GroupName="Dock" Foreground="#E0E0E0" Margin="0,4"/>
                                <RadioButton x:Name="RbDockTop" Content="Dock to Screen Top (Full width at top)" GroupName="Dock" Foreground="#E0E0E0" Margin="0,4"/>
                                <RadioButton x:Name="RbDockFloating" Content="Free Floating (Draggable and resizable from all 8 borders)" GroupName="Dock" Foreground="#E0E0E0" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Card: Default Startup Layout -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Default Layout" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Initial layout loaded when the keyboard starts." FontSize="11" Foreground="#9595A2" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="CbDefaultLayout" Background="#2C2C34" Foreground="Black" Height="32" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Windows 10 Touch Keyboard" Tag="touch"/>
                                    <ComboBoxItem Content="Windows 10 Full Keyboard (5-Row)" Tag="full"/>
                                    <ComboBoxItem Content="Windows 10 PIN / Numpad" Tag="numpad"/>
                                    <ComboBoxItem Content="Windows 10 Symbols (&amp;123)" Tag="symbol"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PANEL 3: Lock Screen & Security -->
                <ScrollViewer x:Name="PanelLockScreen" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Card: Session Lock Winlogon Integration -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Lock Screen Desktop Integration" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Spawns an isolated secure on-screen keyboard on the Winlogon desktop when Windows locks (Win+L)." 
                                               FontSize="11" Foreground="#9595A2" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkLockScreen" Style="{StaticResource FluentToggleSwitchStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Card: Ease of Access OSK Registration -->
                        <Border Style="{StaticResource FluentSettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Windows Ease of Access Registration" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Registers Hot Virtual Keyboard with Windows Ease of Access so clicking the Accessibility icon on the Lock Screen launches this keyboard." 
                                           FontSize="11" Foreground="#9595A2" TextWrapping="Wrap" Margin="0,3,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnRegisterOsk" Content="Register as System OSK" Click="BtnRegisterOsk_Click" Style="{StaticResource FluentPrimaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnUnregisterOsk" Content="Unregister" Click="BtnUnregisterOsk_Click" Style="{StaticResource FluentSecondaryButtonStyle}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtOskStatus" Text="" FontSize="11" Foreground="#10B981" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ROW 3: Bottom Action Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="Save Settings" Click="BtnSave_Click" Style="{StaticResource FluentPrimaryButtonStyle}" Width="130" Margin="0,0,10,0"/>
                <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource FluentSecondaryButtonStyle}" Width="90"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
