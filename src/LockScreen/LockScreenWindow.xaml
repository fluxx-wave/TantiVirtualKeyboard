<Window x:Class="HotVirtualKeyboard.LockScreen.LockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lock Screen Virtual Keyboard"
        Height="280" Width="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Border Background="#F0181818" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="8">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="🔒 LOCK SCREEN KEYBOARD" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                    <Button x:Name="BtnModeToggle" Content="Switch to Full Letters" Click="BtnModeToggle_Click" 
                            Background="#2A2A2A" Foreground="#FFFFFF" BorderThickness="0" Margin="12,0,0,0" Padding="8,2" FontSize="10" Focusable="False"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Click="BtnClose_Click" Background="Transparent" Foreground="#888888" 
                        BorderThickness="0" Width="28" Height="24" FontSize="12" Focusable="False" ToolTip="Dismiss"/>
            </Grid>

            <!-- Key Matrix Container -->
            <Grid Grid.Row="1" x:Name="LockKeysGrid" Margin="2">
                <!-- Keys dynamically rendered -->
            </Grid>
        </Grid>
    </Border>
</Window>
